.chat-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f7fb;
}

.message-list {
  flex: 1;
  box-sizing: border-box;
  height: calc(100vh - 156rpx);
  padding: 28rpx 28rpx 20rpx;
}

.message-row {
  display: flex;
  margin: 18rpx 0;
}

.message-row.assistant {
  justify-content: flex-start;
}

.message-row.user {
  justify-content: flex-end;
}

.bubble {
  max-width: 78%;
  box-sizing: border-box;
  padding: 22rpx 26rpx;
  border-radius: 24rpx;
  font-size: 29rpx;
  line-height: 1.62;
  word-break: break-word;
}

.assistant .bubble {
  background: #ffffff;
  color: #20242a;
  border: 1rpx solid rgba(32, 36, 42, 0.08);
}

.user .bubble {
  background: #2f624c;
  color: #ffffff;
}

.composer {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  box-sizing: border-box;
  padding: 18rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(245, 247, 251, 0.96);
  border-top: 1rpx solid rgba(32, 36, 42, 0.08);
}

.input {
  flex: 1;
  min-height: 48rpx;
  max-height: 180rpx;
  box-sizing: border-box;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #20242a;
  font-size: 29rpx;
  line-height: 1.45;
}

.send-button {
  flex: 0 0 128rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: #2f624c;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.send-button[disabled] {
  background: #a8b5aa;
  color: #f5f7fb;
}
